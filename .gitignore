node_modules/
coverage/
.DS_Store

# Project-local tool state. Canonical config/marker generation is reproducible;
# absolute paths, caches, logs, and runtime databases stay on each host.
.claude/
.codex/
.spotter/
.codex-sidecar/

# 旧RC3 campaignの履歴用run state（現役CLIのstoreではない）。
research/runs/

# Generated TODO projections are reproducible; the TODO store itself is tracked.
.lattice/generated/
# independence判定は現在のcode状態(base_sha)についての証拠であり、witness setから再生成できる。
# 追跡するとcommitのたびにHEADが進んで自分自身をstaleにするため、host localの投影として扱う（ADR 0127）。
.lattice/todo/plans/*/*/independence.json
# seam提案も同じ並置artifactで、independence記録とHEADから再生成できる。
.lattice/todo/plans/*/*/seam-proposal.json
# Host-local exclusion state must never be distributed with durable store bytes.
.lattice/todo/**/.write.lock
.lattice/todo/**/.write.lock.*
.lattice/todo/.cross-plan-recovery/
# Project-local orchestration run state（ADR 0060）。
.lattice/runs/
# upstream (CodeGraph) のbare clone。scripts/upstream-sync.mjsが再取得できる派生物で、
# 追跡すると第三者repoの全履歴をこのrepoへ抱え込むことになる。
.lattice/upstream-cache/
